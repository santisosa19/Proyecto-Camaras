APP_NAME=Traffic Analysis System
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false

API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2
API_RELOAD=false

DATABASE_URL=postgresql://traffic_user:traffic_password@localhost:5432/traffic_db
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

JWT_SECRET_KEY=change-this-secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Required in production
INGEST_API_KEY=change-this-ingest-key
ADMIN_API_KEY=change-this-admin-key

# Comma-separated values are supported too
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO
