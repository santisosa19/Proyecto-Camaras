# ------------------------------
# Global compose variables
# ------------------------------
APP_ENVIRONMENT=development
APP_DEBUG=false
LOG_LEVEL=INFO

# API
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Security
JWT_SECRET_KEY=change-this-secret
INGEST_API_KEY=change-this-ingest-key
ADMIN_API_KEY=change-this-admin-key

# PostgreSQL
POSTGRES_USER=traffic_user
POSTGRES_PASSWORD=traffic_password
POSTGRES_DB=traffic_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://traffic_user:traffic_password@postgres:5432/traffic_db

# Redis / Celery
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
FLOWER_PORT=5555

# Edge agent
CAMERA_ID=camara_prueba_marathon
CAMERA_NAME=Camara de Prueba Marathon
CAMERA_RTSP_URL=rtsp://user:password@camera_ip:554/Streaming/Channels/101
SAVE_TO_DB=false
SAVE_TO_API=true
REMOTE_API_BASE_URL=http://server-backend:8000
REMOTE_API_KEY=change-this-ingest-key
BRANCH_ID=branch_001
BRANCH_NAME=Main Branch
PILOT_MODE=false
DETECTION_SNAPSHOT_INTERVAL_SECONDS=
SHOW_WINDOW=false
MAX_INGEST_QUEUE_SIZE=10000
APPARENT_GENDER_ENABLED=true
GENDER_AUTO_DOWNLOAD_MODEL=true
GENDER_MODEL_DIR=models/gender
GENDER_MODEL_PROTOTXT=
GENDER_MODEL_WEIGHTS=
GENDER_SAMPLE_EVERY_N_FRAMES=10
GENDER_VOTE_WINDOW=12
GENDER_MIN_VOTES=5
GENDER_CONFIDENCE_THRESHOLD=0.64
GENDER_AGGREGATE_CONFIDENCE_THRESHOLD=0.67
GENDER_FEMALE_CONFIDENCE_THRESHOLD=0.78
GENDER_LOCK_CONFIDENCE_THRESHOLD=0.72
GENDER_LOCK_MIN_VOTES=6
GENDER_FLIP_MARGIN=0.18
GENDER_FLIP_MIN_VOTES=6
GENDER_STALE_TRACK_SECONDS=25
