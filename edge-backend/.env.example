# RTSP camera source (required)
CAMERA_RTSP_URL=rtsp://user:password@camera_ip:554/Streaming/Channels/101

# Local persistence in edge DB (currently optional / disabled by default)
SAVE_TO_DB=false

# Remote ingestion to central server
SAVE_TO_API=true
REMOTE_API_BASE_URL=http://localhost:8000
REMOTE_API_KEY=change-this-ingest-key

# Branch metadata
BRANCH_ID=branch_001
BRANCH_NAME=Main Branch

# Runtime behavior
SHOW_WINDOW=false
MAX_INGEST_QUEUE_SIZE=10000

# YOLO + tracking (recommended defaults for better stability)
YOLO_MODEL_PATH=yolov8n.pt
YOLO_DEVICE=auto
YOLO_CONFIDENCE=0.22
YOLO_IOU=0.60
YOLO_IMAGE_SIZE=1280
YOLO_MAX_DETECTIONS=120
YOLO_TRACKER=trackers/bytetrack_stable.yaml
MAX_TRACK_AGE_SECONDS=8

# Apparent gender (optional, adds extra processing)
APPARENT_GENDER_ENABLED=false
GENDER_MODEL_DIR=models/gender
GENDER_MODEL_PROTOTXT=
GENDER_MODEL_WEIGHTS=
GENDER_AUTO_DOWNLOAD_MODEL=true
GENDER_SAMPLE_EVERY_N_FRAMES=5
GENDER_VOTE_WINDOW=12
GENDER_MIN_VOTES=2
GENDER_CONFIDENCE_THRESHOLD=0.52
GENDER_STALE_TRACK_SECONDS=25

# Heatmap (occupancy map)
HEATMAP_ENABLED=true
SHOW_HEATMAP_OVERLAY=true
HEATMAP_CELL_SIZE=24
HEATMAP_OVERLAY_ALPHA=0.35
HEATMAP_BLUR_KERNEL=21
HEATMAP_DECAY_PER_SECOND=0.0
HEATMAP_NORMALIZATION_PERCENTILE=99
HEATMAP_NORMALIZATION_RISE_ALPHA=0.08
HEATMAP_NORMALIZATION_FALL_ALPHA=0.01
HEATMAP_NORMALIZATION_GAMMA=0.85
HEATMAP_OVERLAY_MIN_INTENSITY=1
SAVE_HEATMAP_SNAPSHOTS=true
HEATMAP_SNAPSHOT_INTERVAL_SECONDS=60
HEATMAP_OUTPUT_DIR=heatmaps
HEATMAP_KEEP_HISTORY=false
SEND_HOURLY_HEATMAP_TO_API=true
HOURLY_HEATMAP_PARTIAL_FLUSH_SECONDS=60
HEATMAP_BACKGROUND_MAX_WIDTH=960
HEATMAP_BACKGROUND_JPEG_QUALITY=68
HEATMAP_BACKGROUND_REFRESH_SECONDS=30
